# PostgreSQL nuevo y exclusivo para este backend. No apuntar a la base legacy.
POSTGRES_USER=puntazo
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=puntazo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://puntazo:replace-with-url-encoded-password@db:5432/puntazo?sslmode=disable

# Secretos de runtime. Reemplazar; nunca exponerlos en variables EXPO_PUBLIC_*.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=puntazo
QR_PEPPER=replace-with-a-different-32-byte-secret
DEMO_ACCESS_CODE_HASH=replace-with-a-bcrypt-hash

# Comportamiento y orígenes. CORS_ORIGINS acepta una lista separada por comas.
DEMO_SIGNUP_ENABLED=false
GOOGLE_CLIENT_ID=
CORS_ORIGINS=
APP_VERSION=dev
GIT_COMMIT=0000000
EXPECTED_SCHEMA_VERSION=0005
PORT=8080
API_PORT=8080
TRUSTED_PROXY_COUNT=0

# Overlay de facturación; complementar la configuración completa del backend.
# Esta plantilla NO habilita cobros. Importar sólo estas variables en Coolify.
MERCADO_PAGO_PROVIDER=disabled
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_API_URL=https://api.mercadopago.com
MERCADO_PAGO_TIMEOUT_MS=10000
PUBLIC_APP_URL=https://puntazo.pro
# Defaults existentes, no una aprobación de precios comerciales nuevos.
# subscription_prices tiene prioridad sobre estos defaults.
MERCADO_PAGO_BRANCH_PRICE_CENTS=2500000
MERCADO_PAGO_POINTS_BRANCH_PRICE_CENTS=2000000
BRANCH_PRORATION_ENABLED=false
BRANCH_PAYMENT_SIMULATOR=false
# APP_ENV=production pertenece a la configuración completa, no a este overlay.
# Requiere preparar previamente SMTP/verificación, cifrado, S3 y Redis/TLS.
# Webhook futuro: https://api.puntazo.pro/v1/mercado-pago/webhooks
# Retorno del checkout: https://puntazo.pro/suscripcion/resultado
